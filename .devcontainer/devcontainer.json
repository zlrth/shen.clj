{
  "name": "shen.clj",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // 21 and 25 are what CI tests. Change this to 25 (and rebuild) to work
      // against the upper bound.
      "JDK_VERSION": "21"
    }
  },

  // Claude Code, the default-deny egress firewall, persistent auth/state, and
  // the scoped sudo that keeps the agent from flushing its own rules all come
  // from this feature. It declares NET_ADMIN/NET_RAW itself; do NOT add
  // --cap-drop=ALL here, because sudo needs SETUID/SETGID and dropping them
  // takes the firewall script with it.
  "features": {
    "ghcr.io/zlrth/devcontainer-features/claude-sandbox:1": {
      // Maven Central and Clojars for :deps, plus the GitHub hostnames that
      // io.github.cognitect-labs/test-runner is fetched from (belt and braces
      // over the published ranges the feature already allows).
      "allowedDomains": "repo1.maven.org repo.maven.apache.org repo.clojars.org codeload.github.com objects.githubusercontent.com raw.githubusercontent.com"
    }
  },

  "runArgs": [
    "--memory=8g"
  ],

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "mounts": [
    // Dependency caches live in volumes rather than on the bind mount: Maven
    // resolution across Docker Desktop's file sharing is painfully slow, and
    // these are exactly the paths CI caches.
    "source=shen-clj-m2,target=/home/dev/.m2,type=volume",
    "source=shen-clj-gitlibs,target=/home/dev/.gitlibs,type=volume",

    // .cpcache MUST be isolated from the host's. The Clojure CLI always
    // prefers ./.cpcache over CLJ_CACHE when the project directory is
    // writable, and it caches absolute classpaths — the host's entries point
    // at /Users/..., which does not exist in here.
    "source=shen-clj-cpcache,target=/workspace/.cpcache,type=volume",

    // target/ is isolated too, so container and host builds do not overwrite
    // each other's render — and so switching JDK_VERSION does not leave a
    // half-built tree behind. `docker volume rm shen-clj-target` forces the
    // from-scratch render that CI deliberately never caches.
    "source=shen-clj-target,target=/workspace/target,type=volume"
  ],

  "remoteUser": "dev",

  "containerEnv": {
    // Produced on the host by `claude setup-token`. Mounting ~/.claude would
    // not work as a substitute: on macOS the OAuth credentials live in the
    // Keychain, not in that directory.
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  "customizations": {
    "vscode": {
      "extensions": ["betterthantomorrow.calva"]
    }
  }
}
