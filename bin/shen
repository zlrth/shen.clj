#!/usr/bin/env bash
# Starts the Shen REPL. Renders the kernel from KLambda on first run.
set -e

cd "$(dirname "$0")/.."

jar=(target/shen.clj-*-standalone.jar)

# Readline only helps a person at a terminal; keep it out of the way when
# stdin is a pipe or a file, so the REPL can be used to run a script.
rlwrap=
if [ -t 0 ]; then
	rlwrap=$(command -v rlwrap || true)
fi

if [ -e "${jar[0]}" ]; then
	exec $rlwrap java -Xss16m $JAVA_OPTS -jar "${jar[0]}" "$@"
else
	exec $rlwrap clojure -J-Xss16m -M:repl "$@"
fi
